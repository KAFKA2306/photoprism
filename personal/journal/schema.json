{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "月次写真日記",
  "type": "object",
  "additionalProperties": false,
  "required": ["month", "title", "body", "photos", "status"],
  "properties": {
    "month": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string"
    },
    "status": {
      "enum": ["draft", "ready", "public"],
      "default": "draft",
      "description": "draft=編集中、ready=本人確認済みだが非公開、public=公開出力可"
    },
    "places": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "album_uids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "tags": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source"],
        "properties": {
          "source": {"enum": ["photoprism", "google_photos", "amazon_photos", "local", "text", "manual"]},
          "source_id": {"type": "string"},
          "imported_at": {"type": "string"},
          "note": {"type": "string"}
        }
      },
      "default": []
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["src", "alt"],
        "properties": {
          "src": {"type": "string", "minLength": 1},
          "alt": {"type": "string", "minLength": 1},
          "caption": {"type": "string"},
          "place": {"type": "string"},
          "photo_uid": {"type": "string"},
          "taken_at": {"type": "string"},
          "source": {"enum": ["photoprism", "google_photos", "amazon_photos", "local", "manual"]}
        }
      }
    }
  }
}
